{
  "name": "llf-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:copy": "node scripts/check-copy.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm check:copy && pnpm format:check",
    "test:e2e": "playwright test",
    "screenshots": "playwright test e2e/screenshots.spec.ts",
    "sanity:seed": "sanity exec scripts/sanity/seed.ts --with-user-token"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.34.6",
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.4.2",
    "next-sanity": "13.3.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "6.18.0",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}

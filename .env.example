# The canonical site address, used for canonical URLs, Open Graph, the sitemap
# and structured data. Leave unset locally. On Vercel, set it for Production
# once the custom domain is live. Without it, the Vercel production URL is used.
NEXT_PUBLIC_SITE_URL=https://literatelives.org

# Search engines are told to stay away until this is "true". Set it only on the
# Production environment at launch.
SITE_INDEXABLE=false

# The canonical site address, used for canonical URLs, Open Graph, the sitemap
# and structured data. Leave unset locally. On Vercel, set it for Production
# once the custom domain is live. Without it, the Vercel production URL is used.
NEXT_PUBLIC_SITE_URL=https://literatelives.org

# Search engines are told to stay away until this is "true". Set it only on the
# Production environment at launch.
SITE_INDEXABLE=false

# The contact form on Get Involved emails the founder through Resend
# (resend.com). Without a key the form says it could not send, and offers the
# email address instead. Set these in Vercel for Production and Preview.
RESEND_API_KEY=
# Who receives the messages. Defaults to founder@literatelives.org.
CONTACT_TO=
# The sender. Until literatelives.org is verified in Resend, leave this unset:
# Resend's test sender then delivers only to the Resend account's own address.
CONTACT_FROM=
